# ─── DPP Agent Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your actual values.

# Groq Cloud API Key (get one at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Ollama base URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Default Ollama model (must be pulled already)
OLLAMA_MODEL=qwen3:1.7b

# Default Groq cloud model
GROQ_MODEL=llama-3.3-70b-versatile

# Wikipedia language (default: en)
WIKI_LANG=en

# Output directory for generated problem sets
OUTPUT_DIR=./output
